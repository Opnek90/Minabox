# Minabox - Environment Configuration
# ====================================
# Kopiere diese Datei zu .env und passe die Werte an:
# cp .env.example .env

# =================================
# Device Configuration
# =================================

# Eindeutige ID dieser Minabox (wird in MQTT-Topics verwendet)
# Format: alphanumerisch, keine Leerzeichen
# Beispiele: box1, livingroom, kidsroom
MINABOX_DEVICE_ID=box1

# =================================
# MQTT Broker
# =================================

# MQTT Broker Port (Standard: 1883)
MQTT_PORT=1883

# =================================
# Backend Service
# =================================

# Backend API Port (Standard: 8080)
BACKEND_PORT=8080

# =================================
# WebUI Service
# =================================

# WebUI Port (Standard: 80)
# Achtung: Port 80 erfordert ggf. Root-Rechte oder ist bereits belegt
# Alternative: 8081 oder 3000
WEBUI_PORT=80

# =================================
# Logging
# =================================

# Log-Level für alle Services
# Mögliche Werte: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Empfehlung: INFO für Produktion, DEBUG für Entwicklung
LOG_LEVEL=INFO

# =================================
# Hinweise
# =================================

# Database Path:
# - Wird automatisch gesetzt auf ./data/minabox.db
# - Persistente Daten werden in ./data/ gespeichert

# Audio Storage:
# - Wird automatisch gesetzt auf ./audio/tracks/
# - Audio-Dateien werden in ./audio/ gespeichert

# Service Configs:
# - Service-spezifische Configs liegen in ./services/<service>/config/
# - Beispiele:
#   - ./services/button-service/config/buttons.json
#   - ./services/led-service/config/leds.json
#   - ./services/audio-service/config/audio.json
#   - ./services/rfid-service/config/service.json

# Hardware-Devices:
# - GPIO: /dev/gpiomem (Button, LED)
# - I2C: /dev/i2c-1 (RFID-Reader)
# - SPI: /dev/spidev0.0 (RFID-Reader, alternativ)
# - Audio: /dev/snd (Audio-Ausgabe)

# Troubleshooting:
# - Falls Hardware-Zugriff nicht funktioniert, kann privileged mode aktiviert werden:
#   Kommentiere in docker-compose.yml die Zeile "privileged: true" ein
#   (weniger sicher, aber einfacher für Debugging)
