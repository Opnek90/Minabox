{
  "leds": [
    {
      "id": "led_5",
      "name": "Blau",
      "gpio": 17,
      "bindings": {
        "system_online": {
          "pattern_type": "solid",
          "duration_ms": 0
        }
      }
    },
    {
      "id": "led_6",
      "name": "Rot",
      "gpio": 27,
      "bindings": {
        "system_error": {
          "pattern_type": "pulse",
          "duration_ms": 250
        },
        "rfid_unknown_tag": {
          "pattern_type": "blink",
          "duration_ms": 500,
          "interval_ms": 500,
          "repeat": 1
        },
        "backend_unreachable": {
          "pattern_type": "solid",
          "duration_ms": 0
        },
        "usage_denied": {
          "pattern_type": "pulse",
          "duration_ms": 200,
          "repeat": 1
        }
      }
    },
    {
      "id": "led_7",
      "name": "Grün",
      "gpio": 22,
      "bindings": {
        "audio_playing": {
          "pattern_type": "solid",
          "duration_ms": 0
        },
        "audio_paused": {
          "pattern_type": "off",
          "duration_ms": 0
        },
        "audio_stopped": {
          "pattern_type": "off",
          "duration_ms": 0
        }
      }
    },
    {
      "id": "led_8",
      "name": "Gelb",
      "gpio": 23,
      "bindings": {
        "button_pressed": {
          "pattern_type": "blink",
          "duration_ms": 500,
          "repeat": 1,
          "interval_ms": 500
        },
        "rfid_scanned": {
          "pattern_type": "blink",
          "duration_ms": 500,
          "repeat": 1,
          "interval_ms": 500
        }
      }
    }
  ]
}