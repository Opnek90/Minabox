# Minabox - Git Ignore
# ====================

# =================================
# Environment & Secrets
# =================================
.env
.env.*backup*
.env.bak
.env.local
.env.*.local
*.key
*.pem
*.crt

# =================================
# Database & Data
# =================================
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =================================
# Audio Files
# =================================
audio/tracks/
# Behalte die Ordnerstruktur, aber nicht die Dateien
!audio/tracks/.gitkeep

# =================================
# Config Files
# =================================

services/audio-service/config/audio.json
services/audio-service/state/audio_state.json
services/button-service/config/buttons.json
services/display-service/config/display.json
services/led-service/config/leds.json

# =================================
# Logs
# =================================
logs/
*.log

# =================================
# Docker
# =================================
.docker/

# =================================
# Python
# =================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
PIPFILE.lock

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Poetry
poetry.lock

# =================================
# Node.js / Frontend
# =================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Output
dist/
dist-ssr/
build/
*.local

# =================================
# IDEs & Editors
# =================================

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.Trash-*
.nfs*

# =================================
# Testing
# =================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# =================================
# Temporary Files
# =================================
*.tmp
*.temp
*.bak
*.swp
*.swo

# =================================
# Service-specific Configs (Generated)
# =================================
# Diese Dateien werden zur Laufzeit generiert/modifiziert
# und sollten nicht committed werden, wenn sie Secrets enthalten
# services/*/config/*.json
# Kommentiere die obige Zeile ein, falls Configs Secrets enthalten

# =================================
# Service State & Tool Caches
# =================================
# Laufzeit-State-Dateien (z.B. letzte Wiedergabeposition)
state/
services/*-service/state/

# Ruff Linter Cache
.ruff_cache/
services/*-service/.ruff_cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytest
.pytest_cache/

# Docker
*.log

# OS
.DS_Store
Thumbs.db
services/audio-service/state/

# =================================
# Agenten-Tooling (lokaler Zustand)
# =================================
# Claude-Code-Arbeitsdaten bleiben lokal - die Skills sind aber Teil des
# Support-Werkzeugs und sollen mit dem Repo mitwandern. Deshalb .claude/* statt
# .claude/: eine Ausnahme innerhalb eines ignorierten *Verzeichnisses* greift
# nicht, das Verzeichnis selbst muss sichtbar bleiben.
.claude/*
!.claude/skills/
.agents/
skills-lock.json
