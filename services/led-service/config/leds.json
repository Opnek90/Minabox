{
  "leds": [
    {
      "id": "led_5",
      "name": "Power-LED",
      "gpio": 17,
      "bindings": {
        "system_online": {
          "pattern_type": "solid",
          "duration_ms": 0
        }
      }
    },
    {
      "id": "led_6",
      "name": "Status-LED",
      "gpio": 27,
      "bindings": {
        "audio_playing": {
          "pattern_type": "solid",
          "duration_ms": 0
        },
        "audio_stopped": {
          "pattern_type": "solid",
          "duration_ms": 1
        },
        "audio_paused": {
          "pattern_type": "solid",
          "duration_ms": 1
        }
      }
    }
  ]
}
