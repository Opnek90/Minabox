# Minabox Environment Configuration
# ==================================
# Copy this file to .env and customize the values
# All variables marked as REQUIRED must be set!

# Device Configuration
# --------------------
# REQUIRED: Unique identifier for this Minabox instance
# Used in MQTT topics: minabox/<device-id>/...
MINABOX_DEVICE_ID=box1

# Language of the first install (install.sh) and the default for the web UI.
# Options: de, en
MINABOX_LANGUAGE=de

# MQTT Broker Configuration
# -------------------------
# REQUIRED: MQTT broker hostname (Docker service name)
MQTT_BROKER=mqtt

# REQUIRED: MQTT broker port
MQTT_PORT=1883

# Optional: MQTT authentication (if broker requires it)
#MQTT_USER=
#MQTT_PASSWORD=

# Host-Helper Authentication
# --------------------------
# REQUIRED: Shared secret between Backend and Host-Helper.
# Without it `docker compose up` aborts (host-helper declares it as required).
# Generate one with:  openssl rand -hex 32
HOST_HELPER_API_KEY=

# Optional: separate secret for signing WebUI session cookies (JWT).
# Falls back to HOST_HELPER_API_KEY when unset. Set this if you do not want
# one secret to serve two purposes.
#WEB_AUTH_SECRET=

# Logging Configuration
# ---------------------
# REQUIRED: Log level for all services
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
# DEBUG: Verbose output, human-readable console format (development)
# INFO:  Standard output, structured JSON format (production)
LOG_LEVEL=INFO

# Database Configuration
# ----------------------
# Path to SQLite database (inside container)
# Default: /data/minabox.db (no need to change)
#DATABASE_PATH=/data/minabox.db

# Audio Storage
# -------------
# Path to audio files storage (inside container)
# Default: /mnt/audio/tracks (no need to change)
#AUDIO_STORAGE_PATH=/mnt/audio/tracks
#AUDIO_STATE_PATH=state/audio_state.json

# Service Ports (Optional - Defaults Provided)
# ---------------------------------------------
# Backend API port (external)
#BACKEND_PORT=8080

# WebUI port (external). Default in docker-compose.yml is 80.
#WEBUI_PORT=80

# Host & Storage Paths (Optional - Defaults Provided)
# ---------------------------------------------------
# Host directory mounted as the audio library (default: ./audio)
#AUDIO_FILES_PATH=./audio

# Base paths the WebUI may pick a media directory from (comma separated)
#ALLOWED_AUDIO_PATHS=/media,/mnt,/home/pi

# Timezone for all containers
#TZ=Europe/Berlin

# Host IP, only needed if autodetection fails
#HOST_IP=

# Set to true to run without GPIO hardware (LED/Button on a dev machine)
#DISABLE_GPIO=false

# Media Downloader (Optional)
# ---------------------------
# Allowed domains are configured in the WebUI (Admin -> General -> media
# import), not here - that list is user-editable and takes effect without a
# restart.
#MEDIA_DOWNLOADER_MAX_FILESIZE_MB=

# Docker socket access (debug export)
# -----------------------------------
# GID of the host "docker" group. The backend container needs it to read
# /var/run/docker.sock (mounted read-only) - without it the diagnostics package
# is missing restart counts, OOM kills and container states.
# Find it on the host with:
#   getent group docker | cut -d: -f3
DOCKER_GID=984

# Component selection (docker compose profiles)
# ---------------------------------------------
# Controls which optional services run. Set by install.sh from the component
# selection. Possible values (comma separated):
#   rfid, led, button, display, media
# The required services (mqtt, backend, host-helper, audio, webui) have no
# profile and always run.
#
# The backend reads this value (via docker-compose.yml) and hides navigation,
# settings and actions for components that are not selected in the web UI.
#
# NOTE: removing a profile here does not stop an already running
# container by itself. Then run once:
#   docker compose down --remove-orphans && docker compose up -d
COMPOSE_PROFILES=rfid

# Container images
# ----------------
# Every service has its own version number, so its own tag too.
# Resolution goes from specific to general:
#
#   1. MINABOX_<SERVICE>_TAG  - applies to this one service only
#   2. MINABOX_IMAGE_TAG      - applies to every service without its own entry
#   3. latest                 - follows the main branch
#
# This lets a single service be pinned or rolled back without touching the
# others - the basis for a targeted update and the way back to a previous
# version.
#
#MINABOX_IMAGE_TAG=latest
#
#MINABOX_BACKEND_TAG=0.1.1
#MINABOX_HOST_HELPER_TAG=0.1.0
#MINABOX_AUDIO_TAG=0.1.0
#MINABOX_RFID_TAG=0.1.0
#MINABOX_BUTTON_TAG=0.1.0
#MINABOX_LED_TAG=0.1.0
#MINABOX_DISPLAY_TAG=0.1.0
#MINABOX_MEDIA_DOWNLOADER_TAG=0.1.1
#MINABOX_WEBUI_TAG=0.1.1

# Host-specific IDs (determined by install.sh)
# --------------------------------------------
# These values differ from Pi to Pi. If they are wrong, the hardware containers
# still start but have no access to the bus or socket.
#
# UID of the user who owns the audio session. The audio container talks to
# PipeWire/PulseAudio over /run/user/<UID>/pulse.
#   id -u
HOST_UID=1000

# GID of the host "i2c" group - RFID reader (PN532) and OLED display.
#   getent group i2c | cut -d: -f3
I2C_GID=988

# GID of the host "gpio" group - LED and button service.
#   getent group gpio | cut -d: -f3
GPIO_GID=986

# Boot partition with config.txt. Bookworm uses /boot/firmware, Bullseye and
# older /boot. A wrong value makes the bind mount - and with it the whole
# stack - fail.
BOOT_CONFIG_DIR=/boot/firmware
