# Minabox Configuration

# Device ID (für MQTT Topics)
MINABOX_DEVICE_ID=box1

# MQTT Broker
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Database
DATABASE_PATH=/data/minabox.db

# Audio Storage
AUDIO_STORAGE_PATH=/mnt/audio/tracks

# Logging
LOG_LEVEL=INFO

# Service Ports (für docker-compose)
BACKEND_PORT=8080
WEBUI_PORT=3000
