{
  "leds": [
    {
      "id": "led_5",
      "name": "Power-LED",
      "gpio": 17,
      "bindings": {
        "system_online": {
          "pattern_type": "solid",
          "duration_ms": 0
        }
      }
    },
    {
      "id": "led_6",
      "name": "Status-LED",
      "gpio": 27,
      "bindings": {
        "audio_playing": {
          "pattern_type": "solid",
          "duration_ms": 0
        },
        "audio_stopped": {
          "pattern_type": "off",
          "duration_ms": 500,
          "interval_ms": 500,
          "repeat": 0
        },
        "audio_paused": {
          "pattern_type": "off",
          "duration_ms": 200,
          "repeat": 0
        }
      }
    },
    {
      "id": "led_7",
      "name": "RFID-LED",
      "gpio": 22,
      "bindings": {
        "rfid_scanned": {
          "pattern_type": "pulse",
          "duration_ms": 400,
          "repeat": 3
        }
      }
    }
  ]
}