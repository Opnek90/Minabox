# Build-Kontext fuer alle Python-Dienste (context: ./services).
#
# Warum hier und nicht je Dienst: Docker liest ausschliesslich die
# .dockerignore im Wurzelverzeichnis des Build-Kontexts. Die Dateien in
# services/<dienst>-service/ wurden nie ausgewertet, und jeder Build hat
# 466 MB hochgeladen - davon 401 MB webui-Abhaengigkeiten, die kein
# Python-Dienst kopiert.
#
# webui-service baut aus einem eigenen, engeren Kontext
# (./services/webui-service) und ist von dieser Datei nicht betroffen.

webui-service/

# Caches von Test- und Typwerkzeugen
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.coverage
htmlcov/

# Tests laufen im Arbeitsbaum, nicht im Image
tests/

# Laufzeitdaten - gehoeren nie ins Image
state/
data/
*.db
*.db-shm
*.db-wal
*.log

# Laufzeit-Configs der Box - gehoeren nicht ins Image.
#
# Die CI baut aus einem Git-Checkout, wo diese vier Dateien gitignored und
# damit gar nicht vorhanden sind; das veroeffentlichte Image enthaelt sie
# also nie. ./scripts/build-local.sh baut dagegen aus dem Arbeitsbaum und
# nahm sie bisher mit - ein lokal gebautes Image verhielt sich damit anders
# als das ausgelieferte (es startete ohne Mount, das echte brach mit
# "Configuration file not found" ab). Die *.example-Vorlagen bleiben drin.
#
# Nicht ausgeschlossen: rfid.json und backend.json. Die beiden sind im Git
# eingecheckt und stecken deshalb auch im veroeffentlichten Image.
audio-service/config/audio.json
button-service/config/buttons.json
display-service/config/display.json
led-service/config/leds.json

# Lokale Umgebungen und Bauartefakte
.venv/
venv/
build/
dist/
*.egg-info/

# Editor und Betriebssystem
.vscode/
.idea/
*.swp
.DS_Store
